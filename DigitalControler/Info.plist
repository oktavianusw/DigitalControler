<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_digitalctl._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jua.DigitalControler.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>digitalcontroler</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Touche uses the camera only to scan the pairing QR code shown on your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Touche finds your Mac on the local network so your iPhone can act as its trackpad.</string>
